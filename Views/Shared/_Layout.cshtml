<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — QazMarket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark site-nav">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Product" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>
                QazMarket
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    <li class="nav-item"><a class="nav-link active" asp-controller="Product" asp-action="Index">Каталог</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">Жоба туралы</a></li>
                    <li class="nav-item"><span class="nav-pill"><i class="bi bi-bag"></i> Интернет-дүкен демосы</span></li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer" id="about">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <div><strong>QazMarket</strong> <span class="footer-muted">— заманауи тауарлар каталогы</span></div>
            <div class="footer-muted">ASP.NET Core MVC · Razor · Bootstrap</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
